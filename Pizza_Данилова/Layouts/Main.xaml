<Page x:Class="Pizza_Данилова.Layouts.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pizza_Данилова.Layouts"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="782"
      Title="Main">

    <Grid Background="White">
        <Grid Height="50" VerticalAlignment="Top" Background="#FFD32F2F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="20,0,0,0">
                <Image Source="/image/icon.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="Меню" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0,0,20,0">
                <Button Content="Мин.Х" Width="80" Height="30" Background="White" Foreground="#FFD32F2F" BorderThickness="0" Margin="0,0,10,0"/>
                <Button Content="Заказы (0)" Width="100" Height="30" Background="White" Foreground="#FFD32F2F" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Margin="0,50,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <Grid Background="#FFF5F5F5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/image/icon.png" Width="80" Height="80" Grid.Column="0" VerticalAlignment="Top" Margin="15,15,0,15"/>

                    <StackPanel Grid.Column="1" Margin="15,15,0,15" VerticalAlignment="Top">
                        <TextBlock Text="Постный салат пацанчелла со сладким перцем" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                        <TextBlock Text="Помидоры, огурцы, болгарский перец, салат Романо, лук репка, гречки" Foreground="Gray" FontSize="12" Margin="0,5,0,5" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Цена: 1000,00 р." Foreground="Black" FontSize="12" Margin="0,0,15,0"/>
                            <TextBlock Text="Вес: 100 гр." Foreground="Black" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,15,15,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="25 см" Width="50" Height="25" Background="White" Foreground="#FFD32F2F" BorderBrush="#FFD32F2F" Margin="0,0,5,0"/>
                            <Button Content="30 см" Width="50" Height="25" Background="#FFD32F2F" Foreground="White" BorderBrush="#FFD32F2F" Margin="0,0,5,0"/>
                            <Button Content="40 см" Width="50" Height="25" Background="White" Foreground="#FFD32F2F" BorderBrush="#FFD32F2F"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <CheckBox Content="Выбрать" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Black"/>
                            <Button Content="-" Width="25" Height="25" Background="#FFD32F2F" Foreground="White" BorderThickness="0"/>
                            <TextBox Text="0" Width="40" Height="25" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#FFD32F2F" BorderThickness="1" Margin="2,0,2,0"/>
                            <Button Content="+" Width="25" Height="25" Background="#FFD32F2F" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>